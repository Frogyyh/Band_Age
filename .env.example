# 로컬 개발: 이 파일을 .env로 복사해서 사용하세요.
# 배포(Render/Railway 등): .env 파일이 아니라 플랫폼의 Environment Variables 설정에
# 아래 값들을 각각 등록해야 합니다. 하나라도 빠지면 서버가 부팅 시 바로 종료됩니다.

# MongoDB Atlas 무료 티어(M0) 클러스터의 연결 문자열
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/band_age

# 충분히 긴 임의 문자열로 교체하세요 (예: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_string

JWT_EXPIRES_IN=7d

# 플랫폼이 자동으로 주입하는 경우가 많음 (없으면 4000 사용)
PORT=4000

# 배포된 프론트엔드 도메인. 여러 개면 콤마로 구분 (예: https://a.com,https://b.com)
# 설정하지 않으면 모든 오리진을 허용합니다 (개발용, 배포 시 반드시 지정 권장).
# 카카오 로그인 성공 후에도 이 목록의 첫 번째 도메인으로 리다이렉트합니다.
FRONTEND_URL=http://localhost:5173

# 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_CLIENT_ID=
# Kakao Developers 콘솔에서 "Client Secret 사용"을 켠 경우에만 입력 (기본은 비활성, 비워두면 됨)
KAKAO_CLIENT_SECRET=
# Kakao Developers > 카카오 로그인 > Redirect URI에 등록한 값과 정확히 일치해야 함
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback
